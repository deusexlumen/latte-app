# LOBBY-LOOP GM-Proxy — Konfiguration (Kopie als .env anlegen)

# Gemini-API-Keys: einzeln oder komma-separiert mehrere
GEMINI_API_KEY=
# Stabile 3.x-IDs, geprueft 12.10.2026 (ai.google.dev + GET /v1beta/models).
# Bei Umbenennung hier ueberschreiben.
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# Proxy-Port (Default 8787)
GM_PROXY_PORT=8787

# Web-Export: erlaubte Browser-Origins (komma-getrennt) oder *; leer = keine CORS-Header
GM_CORS_ORIGINS=
